---
import type { PageContent, SectionKey } from '../content/schema';
import Base from './Base.astro';
import Hero from '../components/sections/Hero.astro';
import TrustBar from '../components/sections/TrustBar.astro';
import Guarantee from '../components/sections/Guarantee.astro';
import HirePaths from '../components/sections/HirePaths.astro';
import FleetGrid from '../components/sections/FleetGrid.astro';
import SpecTable from '../components/sections/SpecTable.astro';
import Applications from '../components/sections/Applications.astro';
import PricingExplainer from '../components/sections/PricingExplainer.astro';
import Packages from '../components/sections/Packages.astro';
import PipelineBundle from '../components/sections/PipelineBundle.astro';
import LeadForm from '../components/sections/LeadForm.astro';
import Faq from '../components/sections/Faq.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { site } from '../content/site';

/**
 * THE template. Every landing page is this layout fed a typed content object;
 * content.sections decides which sections render, in what order.
 */
interface Props {
  content: PageContent;
  headerTagline?: string | undefined;
}

const { content, headerTagline } = Astro.props;

const SECTIONS: Record<SectionKey, (props: { content: PageContent }) => unknown> = {
  trust: TrustBar,
  guarantee: Guarantee,
  paths: HirePaths,
  fleet: FleetGrid,
  spec: SpecTable,
  applications: Applications,
  pricing: PricingExplainer,
  packages: Packages,
  bundle: PipelineBundle,
  form: LeadForm,
  faq: Faq,
};

const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: content.serviceType,
  name: content.meta.title,
  description: content.meta.description,
  url: new URL(`/${content.slug}`, site.url).href,
  provider: {
    '@type': 'LocalBusiness',
    name: site.name,
    telephone: site.phone,
    url: site.url,
  },
  areaServed: site.areaServed.map((name) => ({ '@type': 'Place', name })),
};
---

<Base title={content.meta.title} description={content.meta.description} headerTagline={headerTagline}>
  <Hero hero={content.hero} />
  {content.sections.map((key) => {
    const SectionComponent = SECTIONS[key];
    return <SectionComponent content={content} />;
  })}
  <JsonLd data={service} />
</Base>
