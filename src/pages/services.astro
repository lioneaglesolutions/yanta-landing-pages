---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/corporate/SectionHeading.astro';
import SiteImage from '../components/corporate/SiteImage.astro';
import CtaBand from '../components/corporate/CtaBand.astro';
import { services, servicesIntro, peopleStatement } from '../content/corporate/services';
---

<Base
  title="Services — Poly Welding, HDPE Piping, Mining & Civil | Yanta"
  description="Poly welding, HDPE pipe installation, geosynthetic lining, tailings management, plant installation and civil construction across Queensland and Australia."
  chrome="corporate"
>
  <section class="bg-white py-16">
    <div class="mx-auto max-w-[1180px] px-5">
      <SectionHeading as="h1" kicker={servicesIntro.kicker} heading={servicesIntro.heading} />
      <div class="mt-7 grid max-w-[1020px] gap-6 text-[16.5px] text-muted md:grid-cols-2">
        <p>{servicesIntro.lead}</p>
        <p>{servicesIntro.lead2}</p>
      </div>
    </div>
  </section>

  <section class="bg-navy py-14">
    <div class="mx-auto max-w-[1180px] px-5">
      <p class="max-w-[820px] text-[16.5px] text-[#C7D6E5]">{peopleStatement}</p>
    </div>
  </section>

  {services.map((service, i) => (
    <section id={service.slug} class={`py-14 ${i % 2 === 0 ? 'bg-wash' : 'bg-white'}`}>
      <div class={`mx-auto grid max-w-[1180px] items-center gap-8 px-5 md:grid-cols-2 ${i % 2 === 1 ? 'md:[&>*:first-child]:order-2' : ''}`}>
        <div class="aspect-[16/11] overflow-hidden">
          <SiteImage name={service.image} alt={service.title} class="h-full w-full object-cover" sizes="(min-width: 768px) 560px, 100vw" />
        </div>
        <div>
          <h2 class="text-[19px] font-extrabold tracking-[1px] text-navy uppercase">{service.title}</h2>
          <div class="mt-3 h-1 w-10 bg-green"></div>
          <ul class="mt-5 space-y-2.5 text-[15.5px] text-navy">
            {service.items.map((item) => (
              <li class="flex gap-2.5">
                <span class="font-extrabold text-green" aria-hidden="true">✓</span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  ))}

  <CtaBand />
</Base>
