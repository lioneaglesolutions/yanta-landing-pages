---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/corporate/SectionHeading.astro';
import PhotoBand from '../components/corporate/PhotoBand.astro';
import SiteImage from '../components/corporate/SiteImage.astro';
import CtaBand from '../components/corporate/CtaBand.astro';
import Button from '../components/ui/Button.astro';
import { services } from '../content/corporate/services';
import { featuredEquipment } from '../content/corporate/equipment';
import { projects } from '../content/corporate/projects';

const featuredServices = services.filter((s) =>
  ['plant-installation', 'tailings-management', 'civil-structural'].includes(s.slug),
);
const homeEquipment = featuredEquipment.slice(0, 3);
const featuredProjects = [projects[0], projects[3], projects[7]].filter((p) => p !== undefined);
---

<Base
  title="Yanta — Mining, Industrial & Construction | Rockhampton QLD"
  description="Delivering safe, reliable and high-quality mining and construction solutions across Australia. Civil, structural, tailings, HDPE piping and plant installation — 30+ years."
  chrome="corporate"
>
  <!-- Intro — the original's centred masthead -->
  <section class="bg-white">
    <div class="mx-auto max-w-[820px] px-5 pt-14 pb-12 text-center">
      <p class="text-[13px] font-extrabold tracking-[3px] text-muted uppercase">Mining · Industrial · Construction</p>
      <h1 class="mt-4 text-(length:--text-hero) leading-[1.12] font-extrabold tracking-[-0.5px] text-navy">
        Regional Strength. National Capability.
      </h1>
      <p class="mx-auto mt-5 max-w-[560px] text-[17px] text-muted">
        Delivering safe, reliable and high-quality mining and construction solutions across Australia.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button href="/contact">Start your project</Button>
        <Button href="/yanta-capability-statement.pdf" variant="navy">View our capability statement</Button>
      </div>
    </div>
  </section>

  <PhotoBand image="hero-excavator" alt="Hitachi excavator working under a stormy Central Queensland sky" tall position="center 70%" />

  <!-- About -->
  <section class="bg-white py-16">
    <div class="mx-auto grid max-w-[1180px] items-center gap-10 px-5 md:grid-cols-2">
      <div class="bg-navy p-8 md:p-10">
        <p class="text-[12.5px] font-extrabold tracking-[2px] text-green-light uppercase">About Yanta</p>
        <h2 class="mt-2 text-(length:--text-section) leading-[1.2] font-extrabold tracking-[-0.3px] text-white">
          Delivering Excellence in Mining &amp; Construction
        </h2>
        <div class="mt-6">
          <Button href="/about" variant="hi">Learn more</Button>
        </div>
      </div>
      <div>
        <p class="text-[16.5px] text-muted">
          At Yanta, we deliver civil, structural and mining construction services backed by over 30 years of industry
          experience. Our team provides innovative, high-quality solutions that drive performance and reliability —
          ensuring every project is completed safely, on time, within budget, and to the highest standards.
        </p>
        <ul class="mt-6 space-y-2.5 text-[15.5px] font-semibold text-navy">
          {[
            '30+ years of proven industry experience',
            'Comprehensive services from design to completion',
            'Strong focus on safety, quality, and innovation',
          ].map((point) => (
            <li class="flex gap-2.5">
              <span class="font-extrabold text-green" aria-hidden="true">✓</span>
              {point}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <PhotoBand image="liner-sunset" alt="Bituminous geomembrane liner installation at sunset" position="center 65%" />

  <!-- Services -->
  <section class="bg-wash py-16">
    <div class="mx-auto max-w-[1180px] px-5">
      <SectionHeading
        kicker="Our Services"
        heading="Providing Solutions for Mining, Industrial & Construction"
      />
      <div class="mt-9 grid gap-5 md:grid-cols-3">
        {featuredServices.map((service) => (
          <a href={`/services#${service.slug}`} class="group block bg-white no-underline shadow-[0_1px_3px_rgba(0,27,58,0.08)]">
            <div class="aspect-[16/10] overflow-hidden">
              <SiteImage name={service.image} alt={service.title} class="h-full w-full object-cover" sizes="(min-width: 768px) 380px, 100vw" />
            </div>
            <div class="border-t-4 border-green p-6">
              <h3 class="text-[15px] font-extrabold tracking-[1px] text-navy uppercase">{service.title}</h3>
              <p class="mt-2.5 text-[14.5px] text-muted">{service.blurb}</p>
              <p class="mt-4 text-[13px] font-extrabold tracking-[1px] text-green-btn uppercase group-hover:underline">Learn more →</p>
            </div>
          </a>
        ))}
      </div>
      <div class="mt-8">
        <Button href="/services" variant="navy">View all services</Button>
      </div>
    </div>
  </section>

  <PhotoBand image="loader-pad" alt="Loader carrying materials across a prepared pad" />

  <!-- Equipment -->
  <section class="bg-white py-16">
    <div class="mx-auto max-w-[1180px] px-5">
      <SectionHeading
        kicker="Equipment"
        heading="Reliable Machinery to Hire"
        lead="Browse our range of high-quality equipment available for hire. Each machine is maintained to the highest standards to ensure your projects run efficiently and safely."
      />
      <div class="mt-9 grid gap-5 md:grid-cols-3">
        {homeEquipment.map((machine) => (
          <a href={`/equipment/${machine.slug}`} class="group block border border-line bg-white no-underline">
            <div class="aspect-[4/3] overflow-hidden bg-wash">
              <SiteImage name={machine.image ?? ''} alt={machine.name} class="h-full w-full object-cover" sizes="(min-width: 768px) 380px, 100vw" />
            </div>
            <div class="p-5">
              <h3 class="text-[15.5px] font-extrabold text-navy">{machine.name}</h3>
              <p class="mt-1 text-[13.5px] text-muted">Rental price available on request</p>
              <p class="mt-3 text-[13px] font-extrabold tracking-[1px] text-green-btn uppercase group-hover:underline">Learn more →</p>
            </div>
          </a>
        ))}
      </div>
      <div class="mt-8">
        <Button href="/equipment" variant="navy">Browse all equipment</Button>
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section class="bg-wash py-16">
    <div class="mx-auto max-w-[1180px] px-5">
      <SectionHeading kicker="Projects" heading="Our Recent Major Projects" />
      <div class="mt-9 grid gap-5 md:grid-cols-3">
        {featuredProjects.map((project) => (
          <a href={`/projects/${project.slug}`} class="group block bg-white no-underline shadow-[0_1px_3px_rgba(0,27,58,0.08)]">
            <div class="aspect-[16/10] overflow-hidden">
              <SiteImage name={project.image} alt={project.title} class="h-full w-full object-cover" sizes="(min-width: 768px) 380px, 100vw" />
            </div>
            <div class="p-5">
              <p class="text-[12px] font-extrabold tracking-[1.2px] text-green-btn uppercase">{project.group}</p>
              <h3 class="mt-1 text-[15.5px] font-extrabold text-navy">{project.title}</h3>
              <p class="mt-2 text-[14px] text-muted">{project.summary}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="mt-8">
        <Button href="/projects" variant="navy">See all projects</Button>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
