---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import SiteImage from '../../components/corporate/SiteImage.astro';
import CtaBand from '../../components/corporate/CtaBand.astro';
import Button from '../../components/ui/Button.astro';
import { equipment, equipmentIntro, featuredEquipment } from '../../content/corporate/equipment';

export const getStaticPaths = (() =>
  equipment
    .filter((machine) => machine.slug)
    .map((machine) => ({ params: { slug: machine.slug }, props: { machine } }))) satisfies GetStaticPaths;

const { machine } = Astro.props;
const others = featuredEquipment.filter((m) => m.slug !== machine.slug).slice(0, 3);
---

<Base
  title={`${machine.detailTitle ?? machine.name} — Equipment Hire | Yanta`}
  description={machine.metaDescription ?? `${machine.name} available for hire from Yanta, Rockhampton and across Central Queensland.`}
  chrome="corporate"
>
  <section class="bg-white py-12">
    <div class="mx-auto max-w-[1180px] px-5">
      <nav aria-label="Breadcrumb" class="text-[13px] font-semibold text-muted">
        <a href="/equipment" class="no-underline hover:text-green-btn">Equipment</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span class="text-navy">{machine.detailTitle ?? machine.name}</span>
      </nav>

      <div class="mt-8 grid items-start gap-10 md:grid-cols-2">
        <div class="border border-line bg-white">
          <SiteImage
            name={machine.image ?? ''}
            alt={machine.name}
            class="aspect-[4/3] w-full object-cover"
            sizes="(min-width: 768px) 560px, 100vw"
            loading="eager"
          />
        </div>
        <div>
          <p class="text-[12.5px] font-extrabold tracking-[2px] text-green-btn uppercase">{machine.type}</p>
          <h1 class="mt-2 text-(length:--text-hero) leading-[1.12] font-extrabold tracking-[-0.5px] text-navy">
            {machine.detailTitle ?? machine.name}
          </h1>
          <div class="mt-4 h-1 w-12 bg-green"></div>
          <p class="mt-6 text-[16.5px] text-muted">{machine.detail}</p>
          <p class="mt-6 text-[15px] font-semibold text-navy">Rental price available on request.</p>
          <div class="mt-7 flex flex-wrap gap-3">
            <Button href="/contact">Enquire about this machine</Button>
            <Button href={`mailto:${equipmentIntro.hireEmail}`} variant="navy">Email {equipmentIntro.hireEmail}</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-wash py-14">
    <div class="mx-auto max-w-[1180px] px-5">
      <h2 class="text-[19px] font-extrabold tracking-[1px] text-navy uppercase">Also available</h2>
      <div class="mt-6 grid gap-5 md:grid-cols-3">
        {others.map((other) => (
          <a href={`/equipment/${other.slug}`} class="group block border border-line bg-white no-underline">
            <div class="aspect-[4/3] overflow-hidden">
              <SiteImage name={other.image ?? ''} alt={other.name} class="h-full w-full object-cover" sizes="(min-width: 768px) 380px, 100vw" />
            </div>
            <div class="border-t border-line p-5">
              <h3 class="text-[15px] font-extrabold text-navy">{other.name}</h3>
              <p class="mt-3 text-[13px] font-extrabold tracking-[1px] text-green-btn uppercase group-hover:underline">Learn more →</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand heading="Need this machine on site?" />
</Base>
