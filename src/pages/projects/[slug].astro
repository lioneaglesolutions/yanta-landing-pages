---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import SiteImage from '../../components/corporate/SiteImage.astro';
import SpecSheet from '../../components/corporate/SpecSheet.astro';
import CtaBand from '../../components/corporate/CtaBand.astro';
import { projects } from '../../content/corporate/projects';

export const getStaticPaths = (() =>
  projects.map((project) => ({ params: { slug: project.slug }, props: { project } }))) satisfies GetStaticPaths;

const { project } = Astro.props;
const related = projects.filter((p) => p.slug !== project.slug && p.group === project.group).slice(0, 3);
---

<Base
  title={`${project.metaTitle ?? project.title} — ${project.group} | Yanta`}
  description={`${project.summary} Delivered by Yanta for ${project.client}.`}
  chrome="corporate"
>
  <section class="bg-white pt-12">
    <div class="mx-auto max-w-[1180px] px-5">
      <nav aria-label="Breadcrumb" class="text-[13px] font-semibold text-muted">
        <a href="/projects" class="no-underline hover:text-green-btn">Projects</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span class="text-navy">{project.group}</span>
      </nav>
      <p class="mt-7 text-[12.5px] font-extrabold tracking-[2px] text-green-btn uppercase">{project.client}</p>
      <h1 class="mt-2 max-w-[820px] text-(length:--text-hero) leading-[1.12] font-extrabold tracking-[-0.5px] text-navy">
        {project.title}
      </h1>
      <p class="mt-5 max-w-[720px] text-[17px] text-muted">{project.summary}</p>
    </div>
  </section>

  <div class="mt-10 h-[240px] w-full overflow-hidden sm:h-[360px] lg:h-[460px]">
    <SiteImage
      name={project.image}
      alt={project.title}
      class="h-full w-full object-cover"
      widths={[768, 1440, 2400]}
      sizes="100vw"
      loading="eager"
    />
  </div>

  <section class="bg-white py-14">
    <div class="mx-auto max-w-[1180px] px-5">
      <h2 class="text-[19px] font-extrabold tracking-[1px] text-navy uppercase">Project detail</h2>
      <div class="mt-6 max-w-[860px]">
        <SpecSheet rows={project.specs} />
      </div>
    </div>
  </section>

  {project.gallery && project.gallery.length > 0 && (
    <section class="bg-wash py-14">
      <div class="mx-auto max-w-[1180px] px-5">
        <h2 class="text-[19px] font-extrabold tracking-[1px] text-navy uppercase">On site</h2>
        <div class="mt-6 grid gap-5 sm:grid-cols-2">
          {project.gallery.map((name) => (
            <div class="aspect-[16/10] overflow-hidden bg-white">
              <SiteImage name={name} alt={`${project.title} — site photo`} class="h-full w-full object-cover" sizes="(min-width: 640px) 560px, 100vw" />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="bg-white py-14">
      <div class="mx-auto max-w-[1180px] px-5">
        <h2 class="text-[19px] font-extrabold tracking-[1px] text-navy uppercase">More from {project.group}</h2>
        <div class="mt-6 grid gap-5 md:grid-cols-3">
          {related.map((other) => (
            <a href={`/projects/${other.slug}`} class="group block bg-white no-underline shadow-[0_1px_3px_rgba(0,27,58,0.08)]">
              <div class="aspect-[16/10] overflow-hidden">
                <SiteImage name={other.image} alt={other.title} class="h-full w-full object-cover" sizes="(min-width: 768px) 380px, 100vw" />
              </div>
              <div class="border-t-4 border-green p-5">
                <h3 class="text-[15px] font-extrabold text-navy">{other.title}</h3>
                <p class="mt-3 text-[13px] font-extrabold tracking-[1px] text-green-btn uppercase group-hover:underline">View project →</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBand />
</Base>
