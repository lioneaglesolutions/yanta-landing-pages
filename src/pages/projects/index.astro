---
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/corporate/SectionHeading.astro';
import SiteImage from '../../components/corporate/SiteImage.astro';
import CtaBand from '../../components/corporate/CtaBand.astro';
import { projects, projectGroups } from '../../content/corporate/projects';
---

<Base
  title="Recent Projects — Tailings, Liners & HDPE Pipelines | Yanta"
  description="From Queensland to Western Australia: 1,000,000m² of BGM liner and 29km of HDPE pipeline delivered for Talison Lithium and Cracow Gold Mine."
  chrome="corporate"
>
  <section class="bg-white py-16">
    <div class="mx-auto max-w-[1180px] px-5">
      <SectionHeading
        as="h1"
        kicker="Projects"
        heading="Our Recent Major Projects"
        lead="Tailings storage facilities, geosynthetic lining, HDPE pipelines, pump stations and plant installation — delivered for tier-one mining clients and their engineers."
      />
    </div>
  </section>

  {projectGroups.map((group, gi) => (
    <section class={`py-12 ${gi % 2 === 0 ? 'bg-wash' : 'bg-white'}`}>
      <div class="mx-auto max-w-[1180px] px-5">
        <h2 class="text-(length:--text-section) leading-[1.2] font-extrabold tracking-[-0.3px] text-navy">{group}</h2>
        <div class="mt-3 h-1 w-12 bg-green"></div>
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {projects.filter((p) => p.group === group).map((project) => (
            <a href={`/projects/${project.slug}`} class="group flex flex-col bg-white no-underline shadow-[0_1px_3px_rgba(0,27,58,0.08)]">
              <div class="aspect-[16/10] overflow-hidden">
                <SiteImage name={project.image} alt={project.title} class="h-full w-full object-cover" sizes="(min-width: 768px) 380px, 100vw" />
              </div>
              <div class="flex flex-1 flex-col border-t-4 border-green p-5">
                <h3 class="text-[15.5px] font-extrabold text-navy">{project.title}</h3>
                <p class="mt-2 flex-1 text-[14px] text-muted">{project.summary}</p>
                <p class="mt-4 text-[13px] font-extrabold tracking-[1px] text-green-btn uppercase group-hover:underline">View project →</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  <CtaBand />
</Base>
