---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/** Resolve an image by basename from src/assets/img/site and render it. */
interface Props {
  name: string;
  alt?: string | undefined;
  class?: string | undefined;
  widths?: number[] | undefined;
  sizes?: string | undefined;
  loading?: 'eager' | 'lazy' | undefined;
}

const { name, alt = '', class: className, widths = [480, 960, 1600], sizes = '(min-width: 1180px) 560px, 100vw', loading } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/img/site/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const img = Object.entries(images).find(([path]) => path.includes(`/${name}.`))?.[1]?.default;
---

{img && <Image src={img} alt={alt} class={className} widths={widths} sizes={sizes} loading={loading} />}
