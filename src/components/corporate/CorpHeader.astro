---
import { Image } from 'astro:assets';
import { site } from '../../content/site';
import logo from '../../assets/img/site/logo.png';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => current === href || (href !== '/' && current.startsWith(href));

const links = [{ label: 'Home', href: '/' }, ...site.nav];
---

<header class="border-b border-line bg-white">
  <div class="mx-auto max-w-[1180px] px-4 sm:px-5">
    <div class="flex items-center justify-between gap-2 py-3 sm:gap-4">
      <a href="/" class="shrink-0 no-underline">
        <Image
          src={logo}
          alt="Yanta — Mining, Industrial, Construction"
          width={168}
          densities={[1, 2]}
          loading="eager"
          class="h-auto w-[96px] sm:w-[136px]"
        />
      </a>

      <!-- Desktop nav -->
      <nav aria-label="Main" class="hidden md:block">
        <ul class="flex flex-wrap items-center gap-x-5 gap-y-1 text-[12.5px] font-bold tracking-[1.2px] text-navy uppercase">
          {links.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class={`border-b-2 py-1 no-underline hover:border-green ${isActive(item.href) ? 'border-green' : 'border-transparent'}`}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="flex items-center gap-2">
        <a
          href={`tel:${site.phone}`}
          class="flex min-h-[44px] items-center whitespace-nowrap rounded-[6px] bg-green-btn px-3 text-[13px] font-extrabold text-white no-underline sm:px-4 sm:text-[14px]"
        >
          {site.phoneDisplay}
        </a>
        <!-- Revealed by CSS only when JS is available (see global.css) -->
        <button
          type="button"
          id="nav-toggle"
          class="nav-toggle hidden h-11 w-11 items-center justify-center rounded-[6px] border border-line text-navy md:!hidden"
          aria-controls="site-nav"
          aria-expanded="false"
          aria-label="Menu"
        >
          <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
            <path id="nav-icon-bars" d="M3 6h16M3 11h16M3 16h16" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
            <path id="nav-icon-close" class="hidden" d="M5 5l12 12M17 5L5 17" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile nav panel: visible by default (no-JS), collapsed by CSS when JS is on -->
    <nav id="site-nav" aria-label="Main" class="nav-panel pb-2 md:!hidden">
      <ul class="flex flex-wrap gap-x-5 gap-y-1 text-[12.5px] font-bold tracking-[1.2px] text-navy uppercase md:border-0">
        {links.map((item) => (
          <li class="w-full border-b border-line last:border-b-0">
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class={`flex min-h-[44px] items-center no-underline ${isActive(item.href) ? 'text-green-btn' : ''}`}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('site-nav');
  const bars = document.getElementById('nav-icon-bars');
  const close = document.getElementById('nav-icon-close');

  const setOpen = (open: boolean) => {
    if (!toggle || !panel) return;
    toggle.setAttribute('aria-expanded', String(open));
    if (open) panel.setAttribute('data-open', '');
    else panel.removeAttribute('data-open');
    bars?.classList.toggle('hidden', open);
    close?.classList.toggle('hidden', !open);
  };

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  // Escape closes the menu and returns focus to the button.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });

  // Re-show the desktop nav if the viewport grows while the menu is open.
  window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>
