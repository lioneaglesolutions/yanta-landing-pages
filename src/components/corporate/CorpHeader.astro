---
import { Image } from 'astro:assets';
import { site } from '../../content/site';
import logo from '../../assets/img/site/logo.png';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => current === href || (href !== '/' && current.startsWith(href));
---

<header class="border-b border-line bg-white">
  <div class="mx-auto flex max-w-[1180px] flex-wrap items-center justify-between gap-x-6 gap-y-2 px-5 py-3">
    <a href="/" class="flex items-center gap-3 no-underline">
      <Image src={logo} alt="Yanta — Mining, Industrial, Construction" width={168} densities={[1, 2]} loading="eager" class="h-auto w-[112px] sm:w-[136px]" />
    </a>
    <a
      href={`tel:${site.phone}`}
      class="order-2 whitespace-nowrap rounded-[6px] bg-green-btn px-4 py-2 text-[14px] font-extrabold text-white no-underline sm:order-3"
    >
      {site.phoneDisplay}
    </a>
    <nav aria-label="Main" class="order-3 w-full sm:order-2 sm:w-auto">
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-1 text-[12.5px] font-bold tracking-[1.2px] text-navy uppercase">
        <li>
          <a href="/" class={`border-b-2 py-1 no-underline hover:border-green ${current === '/' ? 'border-green' : 'border-transparent'}`}>Home</a>
        </li>
        {site.nav.map((item) => (
          <li>
            <a href={item.href} class={`border-b-2 py-1 no-underline hover:border-green ${isActive(item.href) ? 'border-green' : 'border-transparent'}`}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
