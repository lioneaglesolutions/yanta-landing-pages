---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/** Full-bleed photo strip between sections — the original site's signature rhythm. */
interface Props {
  image: string;
  alt?: string | undefined;
  tall?: boolean | undefined;
  /** Vertical focus of the crop, e.g. 'center', 'bottom', '50% 30%' */
  position?: string | undefined;
}

const { image, alt = '', tall = false, position = 'center' } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/img/site/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const img = Object.entries(images).find(([path]) => path.includes(`/${image}.`))?.[1]?.default;
---

{img && (
  <div class={`w-full overflow-hidden ${tall ? 'h-[280px] sm:h-[380px] lg:h-[460px]' : 'h-[200px] sm:h-[260px] lg:h-[320px]'}`}>
    <Image
      src={img}
      alt={alt}
      class="h-full w-full object-cover"
      style={`object-position: ${position}`}
      widths={[768, 1440, 2400]}
      sizes="100vw"
    />
  </div>
)}
