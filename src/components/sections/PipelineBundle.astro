---
import type { PageContent } from '../../content/schema';
import Section from '../ui/Section.astro';

interface Props {
  content: PageContent;
}

const { content } = Astro.props;
const bundle = content.bundle;
---

{bundle && (
  <Section tint>
    <div class="rounded-[14px] border-l-8 border-green bg-navy px-6.5 py-7.5 text-white">
      <h2 class="text-(length:--text-section) leading-[1.2] font-extrabold tracking-[-0.3px] text-white">{bundle.heading}</h2>
      <p class="mt-3 max-w-[640px] text-[#C7D6E5]">{bundle.lead}</p>
      <ol class="mt-5 list-none">
        {bundle.steps.map((step, i) => (
          <li class="relative mb-3.5 pl-11 text-base">
            <span
              class="absolute top-0 left-0 flex h-[29px] w-[29px] items-center justify-center rounded-full bg-green text-sm font-extrabold text-white"
              aria-hidden="true"
            >
              {i + 1}
            </span>
            <b class="block">{step.title}</b>
            <span class="text-[14.5px] text-[#A9BDD3]">{step.blurb}</span>
          </li>
        ))}
      </ol>
      <p class="mt-4.5 text-[17px] font-bold text-white">{bundle.kicker}</p>
    </div>
  </Section>
)}
