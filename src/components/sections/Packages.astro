---
import type { PageContent } from '../../content/schema';
import Section from '../ui/Section.astro';

interface Props {
  content: PageContent;
}

const { content } = Astro.props;
const packages = content.packages ?? [];
const intro = content.packagesIntro;
---

<Section tint>
  {intro && (
    <>
      <h2 class="text-(length:--text-section) leading-[1.2] font-extrabold tracking-[-0.3px] text-navy">{intro.heading}</h2>
      <p class="mt-3 max-w-[680px] text-[17px] text-muted">{intro.lead}</p>
    </>
  )}
  <div class="mt-7 grid gap-4.5 md:grid-cols-3">
    {packages.map((pkg) => (
      <div class="rounded-[12px] border border-t-4 border-line border-t-green bg-white p-5.5">
        <h3 class="text-lg font-extrabold text-navy">{pkg.title}</h3>
        <div class="mt-2 mb-1 text-[22px] font-extrabold text-navy">
          {pkg.price}
          <small class="mt-0.5 block text-[13px] font-semibold text-muted">{pkg.priceNote}</small>
        </div>
        <p class="text-[14.5px] text-muted">{pkg.blurb}</p>
      </div>
    ))}
  </div>
  {intro?.footnote && <p class="mt-5 text-sm text-muted">{intro.footnote}</p>}
</Section>
