---
import type { PageContent } from '../../content/schema';
import Section from '../ui/Section.astro';

interface Props {
  content: PageContent;
}

const { content } = Astro.props;
const pricing = content.pricing;
---

{pricing && (
  <Section>
    <div class="rounded-[14px] border-2 border-navy bg-white px-6.5 py-7.5">
      <h2 class="text-(length:--text-section) leading-[1.2] font-extrabold tracking-[-0.3px] text-navy">{pricing.heading}</h2>
      <p class="mt-3 max-w-[680px] text-[17px] text-muted">{pricing.lead}</p>
      <p class="mt-4.5 text-navy">{pricing.intro}</p>
      <ol class="mt-4.5 ml-5 list-decimal text-base text-navy marker:font-extrabold marker:text-green">
        {pricing.drivers.map((driver) => (
          <li class="mb-2.5">
            <b>{driver.title}</b> {driver.body}
          </li>
        ))}
      </ol>
      <p class="mt-4.5 text-navy">{pricing.outro}</p>
      <div class="mt-5.5 rounded-[8px] border-l-[5px] border-green bg-green-wash px-5 py-4.5 text-[17px] font-semibold text-navy">
        {pricing.promise}
      </div>
    </div>
  </Section>
)}
