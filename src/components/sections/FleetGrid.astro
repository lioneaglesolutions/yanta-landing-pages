---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { PageContent } from '../../content/schema';
import Section from '../ui/Section.astro';

interface Props {
  content: PageContent;
}

const { content } = Astro.props;
const fleet = content.fleet ?? [];
const intro = content.fleetIntro;

const images = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/img/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const resolve = (name?: string): ImageMetadata | undefined =>
  name ? Object.entries(images).find(([path]) => path.includes(`/${name}.`))?.[1]?.default : undefined;
---

<Section tint>
  {intro && (
    <>
      <h2 class="text-(length:--text-section) leading-[1.2] font-extrabold tracking-[-0.3px] text-navy">{intro.heading}</h2>
      <p class="mt-3 max-w-[680px] text-[17px] text-muted">{intro.lead}</p>
    </>
  )}
  <div class="mt-7 grid gap-4.5 md:grid-cols-2">
    {fleet.map((machine) => {
      const img = resolve(machine.image);
      return (
        <div class="flex flex-col overflow-hidden rounded-[12px] border border-line bg-white">
          {img ? (
            <Image
              src={img}
              alt={machine.title}
              class="aspect-[16/10] w-full object-cover"
              widths={[480, 760]}
              sizes="(min-width: 768px) 520px, 100vw"
            />
          ) : (
            <div class="flex aspect-[16/10] items-center justify-center bg-[linear-gradient(135deg,#7C99BB,#002B5C)] p-3 text-center text-[13px] font-extrabold tracking-[1px] text-white">
              {machine.title.toUpperCase()}
            </div>
          )}
          <div class="px-4.5 pt-4.5 pb-5">
            <h3 class="text-lg font-extrabold text-navy">
              {machine.href ? (
                <a href={machine.href} class="underline decoration-green decoration-2 underline-offset-4">{machine.title}</a>
              ) : (
                machine.title
              )}
            </h3>
            <ul class="mt-2.5 list-none text-[14.5px] text-muted">
              {machine.uses.map((use) => (
                <li class="relative mb-1 pl-4">
                  <span class="absolute left-1 text-[11px] text-green" aria-hidden="true">▪</span>
                  {use}
                </li>
              ))}
            </ul>
            <span class="mt-3 inline-block rounded-[20px] border border-green bg-green-wash px-2 py-1 text-[11.5px] font-extrabold tracking-[0.6px] text-[#2A7C31] uppercase">
              {machine.tag}
            </span>
          </div>
        </div>
      );
    })}
  </div>
</Section>
