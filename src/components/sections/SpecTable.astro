---
import type { PageContent } from '../../content/schema';
import Section from '../ui/Section.astro';

interface Props {
  content: PageContent;
}

const { content } = Astro.props;
const spec = content.spec ?? [];
const intro = content.specIntro;
---

<Section tint>
  {intro && (
    <h2 class="text-(length:--text-section) leading-[1.2] font-extrabold tracking-[-0.3px] text-navy">{intro.heading}</h2>
  )}
  <div class="mt-6 overflow-hidden rounded-[12px] border border-line bg-white">
    <table class="w-full border-collapse">
      <tbody>
        {spec.map((row) => (
          <tr class="border-b border-line last:border-b-0">
            <th scope="row" class="w-[42%] bg-wash px-4.5 py-3.5 text-left align-top text-[15.5px] font-bold text-navy">
              {row.label}
            </th>
            <td class="px-4.5 py-3.5 text-[15.5px] text-navy">{row.value}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {intro?.footnote && <p class="mt-4 text-[14.5px] text-muted">{intro.footnote}</p>}
</Section>
