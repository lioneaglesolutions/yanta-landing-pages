---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { PageContent } from '../../content/schema';
import { parseBold } from '../../lib/rich';
import { site } from '../../content/site';
import Button from '../ui/Button.astro';

interface Props {
  hero: PageContent['hero'];
}

const { hero } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/img/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const heroImage = hero.image
  ? Object.entries(images).find(([path]) => path.includes(`/${hero.image}.`))?.[1]?.default
  : undefined;

const resolveHref = (href: string): string => (href === 'tel' ? `tel:${site.phone}` : href);
const sub = parseBold(hero.sub);
---

<div class="relative overflow-hidden bg-[linear-gradient(135deg,#0B4788,#001B3A)] text-white" id="top">
  {heroImage && (
    <Image
      src={heroImage}
      alt=""
      class="absolute inset-0 h-full w-full object-cover"
      loading="eager"
      fetchpriority="high"
      widths={[640, 1080, 1600]}
      sizes="100vw"
    />
  )}
  <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(0,27,58,0.74),rgba(0,27,58,0.93))]"></div>

  <div class="relative mx-auto max-w-[1080px] px-5 pt-14 pb-12">
    <span class="mb-4 inline-block rounded-[5px] bg-green px-3 py-1.5 text-[11.5px] font-extrabold tracking-[1.5px] text-white uppercase">
      {hero.eyebrow}
    </span>
    <h1 class="text-(length:--text-hero) leading-[1.1] font-extrabold tracking-[-0.5px]">{hero.h1}</h1>
    <p class="mt-4 max-w-[660px] text-[clamp(16px,2.4vw,19px)] text-[#D3E0EE]">
      {sub.map((seg) => (seg.bold ? <b class="font-bold text-white">{seg.text}</b> : seg.text))}
    </p>
    <div class="mt-7 flex flex-wrap gap-3">
      <Button href={resolveHref(hero.primaryCta.href)}>{hero.primaryCta.label}</Button>
      {hero.secondaryCta && (
        <Button href={resolveHref(hero.secondaryCta.href)} variant="ghost">{hero.secondaryCta.label}</Button>
      )}
    </div>
    {hero.fineprint && <p class="mt-4 text-[13px] text-[#9FB4CC]">{hero.fineprint}</p>}
  </div>
</div>
