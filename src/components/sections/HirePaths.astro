---
import type { PageContent } from '../../content/schema';
import Section from '../ui/Section.astro';

interface Props {
  content: PageContent;
}

const { content } = Astro.props;
const paths = content.paths ?? [];
const intro = content.pathsIntro;
---

<Section>
  {intro && (
    <>
      <h2 class="text-(length:--text-section) leading-[1.2] font-extrabold tracking-[-0.3px] text-navy">{intro.heading}</h2>
      <p class="mt-3 max-w-[680px] text-[17px] text-muted">{intro.lead}</p>
    </>
  )}
  <div class="mt-6 grid gap-4.5 md:grid-cols-2">
    {paths.map((path) => (
      <div
        class={`flex flex-col rounded-[12px] border-2 bg-white p-6 ${
          path.featured ? 'border-green shadow-[0_3px_16px_rgba(65,173,73,0.13)]' : 'border-line'
        }`}
      >
        <span
          class={`mb-3 inline-block self-start rounded-[4px] px-2 py-1 text-[10.5px] font-extrabold tracking-[1px] text-white uppercase ${
            path.featured ? 'bg-green' : 'bg-muted'
          }`}
        >
          {path.badge}
        </span>
        <h3 class="mb-1.5 text-lg font-extrabold text-navy">{path.title}</h3>
        <p class="text-[15px] text-muted">{path.blurb}</p>
        <ul class="mt-3 list-none text-[15px] text-muted">
          {path.points.map((point) => (
            <li class="relative mb-1.5 pl-5.5">
              <span class="absolute left-0 font-extrabold text-green" aria-hidden="true">✓</span>
              {point}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  {intro?.footnote && <p class="mt-4.5 text-[15px] text-muted">{intro.footnote}</p>}
</Section>
