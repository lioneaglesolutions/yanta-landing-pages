# --- Formspree -------------------------------------------------------------
# SECRET. Never commit. Copy .env.example to .env (gitignored) and paste the
# deploy key from Formspree > Settings. Only needed to run `pnpm formspree:deploy`,
# which pushes formspree.json to the project. Not needed to build or serve.
FORMSPREE_DEPLOY_KEY=

# The submission endpoint is public (it ships in the form's action attribute) and
# defaults to the project form in src/lib/constants.ts, so leaving this blank is
# fine. Set it only to point the forms somewhere else.
PUBLIC_FORM_ENDPOINT=

# Analytics — PUBLIC_ = exposed to browser, correct for tag IDs.
# Tags only render when the ID is set, so dev/preview stays clean.
PUBLIC_META_PIXEL_ID=
PUBLIC_GA4_ID=

# Google Ads. The tag ID defaults to Yanta's live account (AW-18350194707) in
# src/lib/env.ts, so leaving this blank still tags production. The two conversion
# labels come from Google Ads > Goals > Conversions > (action) > Tag setup, and
# without them conv() fires the GA4 event but no Ads conversion.
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_GOOGLE_ADS_LEAD_LABEL=
PUBLIC_GOOGLE_ADS_CALL_LABEL=

# Site
PUBLIC_SITE_URL=https://hire.yanta.com.au
PUBLIC_PHONE=+61429165375
