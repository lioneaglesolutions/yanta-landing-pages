# Form (Phase 1: hosted service — Formspree or Web3Forms)
# formspree.io > New Form > copy the endpoint. Send notifications to
# admin@yanta.com.au AND an inbox that pushes to a phone.
PUBLIC_FORM_ENDPOINT=https://formspree.io/f/YOUR_FORMSPREE_ID

# Analytics — PUBLIC_ = exposed to browser, correct for tag IDs.
# Tags only render when the ID is set, so dev/preview stays clean.
PUBLIC_META_PIXEL_ID=
PUBLIC_GA4_ID=
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_GOOGLE_ADS_LEAD_LABEL=
PUBLIC_GOOGLE_ADS_CALL_LABEL=

# Site
PUBLIC_SITE_URL=https://hire.yanta.com.au
PUBLIC_PHONE=+61429165375
